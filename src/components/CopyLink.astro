---
// Small "copy link" button that sits next to a page title and copies the current page's URL.
interface Props { label?: string }
const { label = 'Copy link to this page' } = Astro.props;
---
<button type="button" class="copy-link" aria-label={label} title={label} data-copy-link>
  <svg class="copy-link-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
  <svg class="copy-link-done" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
  <span class="copy-link-tip" role="status" aria-live="polite"></span>
</button>

<script>
  async function copyText(text: string) {
    if (navigator.clipboard && window.isSecureContext) {
      await navigator.clipboard.writeText(text);
      return;
    }
    // Fallback for older browsers / non-HTTPS previews.
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.setAttribute('readonly', '');
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    document.execCommand('copy');
    ta.remove();
  }

  document.addEventListener('click', async (ev) => {
    const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-copy-link]');
    if (!btn) return;
    ev.preventDefault();
    ev.stopPropagation();
    const tip = btn.querySelector('.copy-link-tip');
    const url = location.origin + location.pathname + location.search;
    try {
      await copyText(url);
      btn.classList.add('is-copied');
      if (tip) tip.textContent = 'Link copied';
    } catch {
      if (tip) tip.textContent = 'Couldn’t copy';
      btn.classList.add('is-copied', 'is-failed');
    }
    clearTimeout(Number(btn.dataset.t));
    btn.dataset.t = String(setTimeout(() => {
      btn.classList.remove('is-copied', 'is-failed');
      if (tip) tip.textContent = '';
    }, 1800));
  });
</script>
