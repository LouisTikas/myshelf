---
import Book3D from './Book3D.astro';
import '../styles/shelf3d.css';
import '../styles/arrange.css';
interface Props { items: any[]; title?: string; href?: string; description?: string; scroll?: boolean; limit?: number; height?: number; empty?: string; collection?: string; arrangeKey?: string; filterable?: boolean; seeAll?: boolean }
const { items, title, href, description, scroll = false, limit, height = 180, empty = 'Nothing here yet.', collection, arrangeKey, filterable = false, seeAll = false } = Astro.props;
// Compact per-item data for client-side filters (board games page).
const num = (v) => { const n = parseFloat(v); return Number.isFinite(n) ? n : null; };
function filterData(d) {
  const det = d.details || {};
  let min = num(det.minPlayers), max = num(det.maxPlayers);
  if (min == null && det.players != null) { const m = String(det.players).match(/(\d+)\D*(\d+)?/); if (m) { min = Number(m[1]); max = Number(m[2] || m[1]); } }
  const pt = num(det.playtime);
  const tlo = num(det.minPlaytime) ?? pt, thi = num(det.maxPlaytime) ?? pt;
  return JSON.stringify({ p: [min, max], best: det.bestPlayers || [], t: [tlo, thi], w: num(det.weight), r: d.rating ?? null, s: d.status, m: det.mechanics || [], c: d.genres || [] });
}
const editable = Boolean(collection || arrangeKey);
// SEE ALL only appears once a collection has more than 10 items.
const showSeeAll = seeAll && href && items.length > 10;
const shown = limit ? items.slice(0, limit) : items;
// Board game boxes stand taller than books, so a shelf holding any gets a taller row.
const BOX_SCALE = 1.35;
const rowHeight = shown.some((e) => e.data.type === 'boardgame') ? Math.round(height * BOX_SCALE) : height;
---
<section class="shelf-section">
  {title && (
    <div class="shelf-head">
      <h2>{href ? <a href={href}>{title}</a> : title}</h2>
      <span class="count"><span class="count-n">{items.length}</span>{showSeeAll && <><span class="count-sep" aria-hidden="true">|</span><a class="count-link" href={href}>See all</a></>}</span>
      {editable && (
        <button type="button" class="shelf-edit" data-collection={collection} data-arrange-key={arrangeKey} hidden aria-label={`Arrange ${title}`} title="Arrange this shelf">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
        </button>
      )}
      {href && !seeAll && items.length > shown.length && <a class="see-all" href={href}>See all →</a>}
    </div>
  )}
  {description && <p class="shelf-desc">{description}</p>}
  <div class:list={['shelf', 'shelf-3d', { 'shelf-scroll': scroll }]} style={`--h:${rowHeight}px`} data-collection={collection} data-arrange-key={arrangeKey}>
    {shown.length === 0 && <p class="shelf-empty">{empty}</p>}
    {shown.map((e, i) => (
      <div class="shelf-slot" data-f={filterable ? filterData(e.data) : undefined}>
        <Book3D item={e.data} height={rowHeight} unit={height} href={`/item/${e.id}/`} front={i === 0} />
      </div>
    ))}
  </div>
</section>

<script>
  import '../scripts/shelf3d.js';
  import '../scripts/edit-shelves.js';
</script>
