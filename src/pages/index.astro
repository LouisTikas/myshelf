---
import Base from '../layouts/Base.astro';
import Shelf from '../components/Shelf.astro';
import site from '../data/site.json';
import { getItems, getShelves } from '../lib/items.js';
import { sortShelf, inShelf, showsOnHome } from '../lib/sorting.js';
import { TYPES, TYPE_KEYS } from '../lib/types.js';

const items = await getItems();
const shelves = getShelves();
---
<Base>
  <section class="hero">
    <h1>{site.title}{site.owner && <span class="hero-owner"><span class="sep">|</span>{site.owner}</span>}</h1>
    <p>{site.tagline}</p>
  </section>

  <div class="bookcase">
    {shelves.filter(showsOnHome).map((s) => {
      const list = sortShelf(items.filter((e) => inShelf(e.data, s)), s);
      return <Shelf title={s.name} description={s.description} items={list} href={`/shelf/${s.slug}/`} scroll limit={24} empty="No items on this shelf yet." collection={s.slug} />;
    })}
  </div>
</Base>
