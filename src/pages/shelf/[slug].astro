---
import Base from '../../layouts/Base.astro';
import Shelf from '../../components/Shelf.astro';
import { getItems, getShelves } from '../../lib/items.js';
import { sortShelf } from '../../lib/sorting.js';

export async function getStaticPaths() {
  return getShelves().map((s) => ({ params: { slug: s.slug }, props: { shelf: s } }));
}
const { shelf } = Astro.props;
const items = sortShelf((await getItems()).filter((e) => e.data.collections?.includes(shelf.slug)), shelf);
---
<Base title={shelf.name} description={shelf.description}>
  <section class="page-head">
    <p class="eyebrow">Collection</p>
    <h1>{shelf.name}<button type="button" class="shelf-edit" data-collection={shelf.slug} hidden aria-label={`Arrange ${shelf.name}`} title="Arrange this shelf"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg></button></h1>
    {shelf.description && <p class="lede">{shelf.description}</p>}
  </section>
  <div class="bookcase">
    <Shelf items={items} empty="No items on this shelf yet." collection={shelf.slug} />
  </div>
</Base>
