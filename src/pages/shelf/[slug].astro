---
import Base from '../../layouts/Base.astro';
import Shelf from '../../components/Shelf.astro';
import CopyLink from '../../components/CopyLink.astro';
import MediaFilters from '../../components/MediaFilters.astro';
import '../../styles/filters.css';
import { getItems, getShelves } from '../../lib/items.js';
import { sortShelf, inShelf } from '../../lib/sorting.js';

const env = Astro.locals.runtime.env;
const shelf = (await getShelves(env)).find((s) => s.slug === Astro.params.slug);
if (!shelf) return new Response(null, { status: 404, statusText: 'Not found' });
const items = sortShelf((await getItems(env)).filter((e) => inShelf(e.data, shelf)), shelf);
---
<Base title={shelf.name} description={shelf.description}>
  <section class="page-head">
    <p class="eyebrow">Collection</p>
    <h1>{shelf.name}<CopyLink /><button type="button" class="shelf-edit" data-collection={shelf.slug} hidden aria-label={`Arrange ${shelf.name}`} title="Arrange this shelf"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg></button></h1>
    {shelf.description && <p class="lede">{shelf.description}</p>}
  </section>
  {items.length > 1 && <MediaFilters items={items} />}
  <div class="bookcase scroll-motion-rows">
    <Shelf items={items} empty="No items on this shelf yet." collection={shelf.slug} filterable />
  </div>
</Base>
