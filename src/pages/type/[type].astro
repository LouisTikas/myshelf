---
import Base from '../../layouts/Base.astro';
import Shelf from '../../components/Shelf.astro';
import { getItems } from '../../lib/items.js';
import { TYPES, TYPE_KEYS, STATUS_LABEL } from '../../lib/types.js';
import { sortShelf } from '../../lib/sorting.js';
import arrangements from '../../data/arrangements.json';

export function getStaticPaths() {
  return TYPE_KEYS.map((type) => ({ params: { type } }));
}
const { type } = Astro.params;
const t = TYPES[type];
const all = (await getItems()).filter((e) => e.data.type === type);
const groups = ['in-progress', 'finished', 'want', 'abandoned']
  .map((status) => {
    const key = `${type}:${status}`;
    const list = all.filter((e) => e.data.status === status);
    // Arranged with the pencil? Use that order (new items first); otherwise newest first.
    const items = arrangements[key] ? sortShelf(list, { sort: 'custom', order: arrangements[key] }) : list;
    return { status, key, label: STATUS_LABEL(type, status), items };
  })
  .filter((g) => g.items.length);
---
<Base title={t.plural}>
  <section class="page-head">
    <p class="eyebrow">{all.length} {all.length === 1 ? t.label : t.plural}</p>
    <h1>{t.plural}</h1>
  </section>
  <div class="bookcase">
    {groups.length === 0 && <Shelf items={[]} empty={`No ${t.plural.toLowerCase()} yet.`} />}
    {groups.map((g) => <Shelf title={g.label} items={g.items} arrangeKey={g.key} height={type === 'music' ? 160 : 180} />)}
  </div>
</Base>
