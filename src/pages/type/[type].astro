---
import Base from '../../layouts/Base.astro';
import Shelf from '../../components/Shelf.astro';
import BoardgameFilters from '../../components/BoardgameFilters.astro';
import '../../styles/filters.css';
import { getItems, getShelves, getArrangements } from '../../lib/items.js';
import { TYPES, TYPE_KEYS, STATUS_LABEL } from '../../lib/types.js';
import { sortShelf, inShelf, showsOnType } from '../../lib/sorting.js';

const { type } = Astro.params;
if (!TYPE_KEYS.includes(type)) return new Response(null, { status: 404, statusText: 'Not found' });
const env = Astro.locals.runtime.env;
const t = TYPES[type];
const [items, shelves, arrangements] = await Promise.all([getItems(env), getShelves(env), getArrangements(env)]);
const all = items.filter((e) => e.data.type === type);
const typeCollections = shelves
  .filter(showsOnType)
  .map((c) => ({ c, items: sortShelf(all.filter((e) => inShelf(e.data, c)), c) }))
  .filter((x) => x.items.length);
const groups = ['in-progress', 'finished', 'want', 'abandoned']
  .map((status) => {
    const key = `${type}:${status}`;
    const list = all.filter((e) => e.data.status === status);
    // Arranged with the pencil? Use that order (new items first); otherwise newest first.
    const items = arrangements[key] ? sortShelf(list, { sort: 'custom', order: arrangements[key] }) : list;
    return { status, key, label: STATUS_LABEL(type, status), items };
  })
  .filter((g) => g.items.length);
---
<Base title={t.plural}>
  <section class="page-head">
    <p class="eyebrow">{all.length} {all.length === 1 ? t.label : t.plural}</p>
    <h1>{t.plural}</h1>
  </section>
  {type === 'boardgame' && all.length > 0 && <BoardgameFilters items={all} />}
  <div class="bookcase">
    {groups.length === 0 && <Shelf items={[]} empty={`No ${t.plural.toLowerCase()} yet.`} />}
    {typeCollections.map(({ c, items }) => (
      <Shelf title={c.name} description={c.description} items={items} href={`/shelf/${c.slug}/`} scroll collection={c.slug}
        height={type === 'music' ? 160 : 180} filterable={type === 'boardgame'} />
    ))}
    {groups.map((g) => <Shelf title={g.label} items={g.items} arrangeKey={g.key} height={type === 'music' ? 160 : 180} filterable={type === 'boardgame'} />)}
  </div>
</Base>
